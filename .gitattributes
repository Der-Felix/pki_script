# Set default behavior to use LF line endings
* text=auto eol=lf

# Force LF on scripts, configurations, and templates
*.sh text eol=lf
*.bash text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
pki text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
